---
const cards = [
  {
    problem: 'catch (e) is unknown. You read the function body to learn what failed.',
    title: 'Errors as data',
    items: ['Return ok or err', 'Errors live in the type', 'Handle by name at the edge'],
  },
  {
    problem: 'You unwrap Results by hand in every async handler.',
    title: 'Composes with await',
    items: ['step() inside async fn', 'Happy path reads straight down', 'First error exits the workflow'],
  },
  {
    problem: 'Retries mean another helper library and another config shape.',
    title: 'Reliability built in',
    items: ['step.retry() with backoff', 'Timeouts on any step', 'Resume and idempotency keys'],
  },
];
---

<section
  class="landing-section pillars sl-markdown-no-margin"
  aria-labelledby="pillars-heading"
>
  <div class="landing-inner">
    <header class="pillars__header">
      <span class="landing-eyebrow landing-eyebrow--code">What awaitly solves</span>
      <h2 class="landing-h2" id="pillars-heading">
        Three problems, <em>three primitives.</em>
      </h2>
    </header>

    <div class="pillars__grid">
      <article class="pillar panels">
        <p class="pillar__problem">{cards[0].problem}</p>
        <div class="pillar__arrow" aria-hidden="true">
          <span class="pillar__arrow-line" />
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M8 3v10M4 9l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="pillar__arrow-line" />
        </div>
        <h3 class="pillar__title">{cards[0].title}</h3>
        <ul class="pillar__items">
          {cards[0].items.map((item) => (
            <li>
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="M3 8.5l3 3 7-7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {item}
            </li>
          ))}
        </ul>
        <pre class="pillar__code" is:raw><code><span class="cm">// expected failures become typed values</span>
<span class="kw">return </span><span class="fn">ok</span><span class="pun">({ id, name });</span>
<span class="kw">return </span><span class="fn">err</span><span class="pun">({ </span><span class="id">type</span><span class="pun">: </span><span class="str ok">'USER_NOT_FOUND'</span><span class="pun">, userId });</span></code></pre>
      </article>

      <article class="pillar panels">
        <p class="pillar__problem">{cards[1].problem}</p>
        <div class="pillar__arrow" aria-hidden="true">
          <span class="pillar__arrow-line" />
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M8 3v10M4 9l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="pillar__arrow-line" />
        </div>
        <h3 class="pillar__title">{cards[1].title}</h3>
        <ul class="pillar__items">
          {cards[1].items.map((item) => (
            <li>
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="M3 8.5l3 3 7-7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {item}
            </li>
          ))}
        </ul>
        <pre class="pillar__code" is:raw><code><span class="kw">const </span><span class="id">user</span><span class="pun">  = </span><span class="kw">await </span><span class="fn">step</span><span class="pun">(</span><span class="str">'getUser'</span><span class="pun">, () =&gt; deps.</span><span class="fn">getUser</span><span class="pun">(id));</span>
<span class="kw">const </span><span class="id">order</span><span class="pun"> = </span><span class="kw">await </span><span class="fn">step</span><span class="pun">(</span><span class="str">'getOrder'</span><span class="pun">, () =&gt; deps.</span><span class="fn">getOrder</span><span class="pun">(user.id));</span>
<span class="kw">return </span><span class="id">order</span><span class="pun">;</span></code></pre>
      </article>

      <article class="pillar panels">
        <p class="pillar__problem">{cards[2].problem}</p>
        <div class="pillar__arrow" aria-hidden="true">
          <span class="pillar__arrow-line" />
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M8 3v10M4 9l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="pillar__arrow-line" />
        </div>
        <h3 class="pillar__title">{cards[2].title}</h3>
        <ul class="pillar__items">
          {cards[2].items.map((item) => (
            <li>
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="M3 8.5l3 3 7-7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {item}
            </li>
          ))}
        </ul>
        <pre class="pillar__code" is:raw><code><span class="kw">await </span><span class="fn">step.retry</span><span class="pun">(</span><span class="str">'charge'</span><span class="pun">, () =&gt; deps.</span><span class="fn">charge</span><span class="pun">(amt), {</span>
<span class="pun">  </span><span class="id">attempts</span><span class="pun">: </span><span class="str ok">3</span><span class="pun">,</span>
<span class="pun">  </span><span class="id">backoff</span><span class="pun">: </span><span class="str">'exponential'</span><span class="pun">,</span>
<span class="pun">  </span><span class="id">key</span><span class="pun">: </span><span class="str">`charge:${order.idempotencyKey}`</span>
<span class="pun">});</span></code></pre>
      </article>
    </div>
  </div>
</section>
