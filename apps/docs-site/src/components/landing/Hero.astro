---
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import GridBackground from './GridBackground.astro';
import InstallPanel from './InstallPanel.astro';

const logoPath = fileURLToPath(new URL('../../../public/logo-animated.svg', import.meta.url));
const logoSvg = readFileSync(logoPath, 'utf-8');
---

<section class="landing-section landing-section--first hero">
  <GridBackground />
  <div class="landing-inner hero__inner">
    <div class="hero__content">
      <div class="hero__eyebrow">
        <span class="hero__logo" aria-hidden="true" set:html={logoSvg} />
        <span class="landing-eyebrow landing-eyebrow--code hero__eyebrow-text">awaitly</span>
      </div>

      <h1 class="hero__headline">
        <span class="hero__line hero__line--1">Typed errors in</span>
        <span class="hero__line hero__line--2">the <em>async/await</em> you write today.</span>
      </h1>

      <p class="hero__lead">
        When a step fails, TypeScript names the error. You keep plain async functions.
        Retries, timeouts, and resume land on the steps that need them.
      </p>

      <div class="hero__install-wrap">
        <InstallPanel />
      </div>

      <div class="hero__actions">
        <a href="getting-started/installation/" class="landing-btn landing-btn--primary">
          Get started
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href="getting-started/why-awaitly/" class="landing-btn landing-btn--ghost">
          Why awaitly
        </a>
      </div>

      <aside class="hero__strip panels" aria-hidden="true">
        <div class="hero__strip-item panels">
          <span class="hero__strip-label">Bundled</span>
          <span class="hero__strip-value">Result · Workflow · step()</span>
        </div>
        <div class="hero__strip-item panels">
          <span class="hero__strip-label">Built in</span>
          <span class="hero__strip-value">Retries · Timeouts · Resume · Idempotency</span>
        </div>
        <div class="hero__strip-item panels">
          <span class="hero__strip-label">Inferred</span>
          <span class="hero__strip-value">Error unions from your deps</span>
        </div>
      </aside>
    </div>
  </div>
</section>
