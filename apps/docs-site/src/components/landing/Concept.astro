---
const steps = [
  { id: 'getOrder', errors: ['ORDER_NOT_FOUND'] },
  { id: 'getUser', errors: ['USER_NOT_FOUND'] },
  { id: 'charge', errors: ['CHARGE_DECLINED', 'INSUFFICIENT_FUNDS'] },
];

// Derived, not written twice: the whole point of the section is that the union
// is exactly what the steps can fail with, so truncating it or letting it drift
// from the diagram undercuts the claim. UnexpectedError is always in there.
const errorUnion = [...steps.flatMap((s) => s.errors), 'UnexpectedError'].join(' | ');
const resultType = `Result<Charge, ${errorUnion}>`;
---

<section class="landing-section concept" aria-labelledby="concept-heading">
  <div class="landing-inner">
    <header class="concept__header">
      <span class="landing-eyebrow landing-eyebrow--code">Mental model</span>
      <h2 class="landing-h2" id="concept-heading">
        Call <em>step()</em>. Get the value or stop.
      </h2>
      <p class="landing-lead">
        Each dependency returns a <code>Result</code>.
        <code>step()</code> unwraps it inside your async function.
        Add a step and the error union grows; remove one and it shrinks.
      </p>
    </header>

    <div class="concept__type-card mental-model" role="img" aria-label="Result type with success and error parameters">
      <div class="concept__type-signature">
        <span class="concept__type-name">Result</span><span class="concept__type-pun">&lt;</span><span class="concept__type-part concept__type-part--ok" data-part="ok">Charge</span><span class="concept__type-pun">, </span><span class="concept__type-part concept__type-part--err" data-part="err">{errorUnion}</span><span class="concept__type-pun">&gt;</span>
      </div>
      <div class="concept__type-labels panels">
        <div class="concept__type-label" data-part="ok">
          <span class="concept__type-label-name">Success</span>
          <span class="concept__type-label-hint">What you return</span>
        </div>
        <div class="concept__type-label" data-part="err">
          <span class="concept__type-label-name">Error</span>
          <span class="concept__type-label-hint">What can fail</span>
        </div>
      </div>
    </div>

    <div
      class="concept__diagram sl-markdown-no-margin"
      role="img"
      aria-label="Workflow steps unwrap on success and short-circuit on error"
    >
      <div class="concept__track">
        <div class="concept__rail" aria-hidden="true"></div>

        {
          steps.map((s, i) => (
            <div class="concept__node flows" style={`--i:${i}`}>
              <div class="concept__node-frame panels">
                <span class="concept__node-id">
                  step {String(i + 1).padStart(2, '0')}
                </span>
                <code class="concept__node-name">{s.id}</code>
                <ul class="concept__node-errs">
                  {s.errors.map((e) => (
                    <li>
                      <span class="concept__err-dot" aria-hidden="true" />
                      {e}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="concept__edge concept__edge--ok" aria-hidden="true">
                <span class="concept__edge-label">ok</span>
                <svg viewBox="0 0 24 12" preserveAspectRatio="none">
                  <path
                    d="M0 6 H22 M16 1 L22 6 L16 11"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>
            </div>
          ))
        }

        <div class="concept__terminal" aria-hidden="true">
          <span class="concept__terminal-mark">✓</span>
          <span class="concept__terminal-label">return Charge</span>
        </div>
      </div>

      <div class="concept__exit" aria-hidden="true">
        {
          steps.map((_, i) => (
            <div
              class="concept__exit-line"
              style={`--i:${i}; --total:${steps.length}`}
            />
          ))
        }
        <div class="concept__exit-target">
          <span class="concept__exit-label">err</span>
          <code class="concept__exit-type">{resultType}</code>
        </div>
      </div>
    </div>

    <p class="concept__caption">
      <code>step.retry()</code>, <code>step.withTimeout()</code>, and idempotency keys
      use the same shape. The union still reflects your deps.
    </p>
  </div>
</section>
