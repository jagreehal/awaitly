{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    // Build is tsup (it emits the .d.ts). These stay off so the paths-to-source
    // mapping below does not trip TS6059 rootDir checks during type-check.
    "declaration": false,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "awaitly": ["../awaitly/src/index.ts"],
      "awaitly/durable": ["../awaitly/src/durable-bundle-entry.ts"],
      "awaitly/testing": ["../awaitly/src/testing-entry.ts"],
      "awaitly/result": ["../awaitly/src/result/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
