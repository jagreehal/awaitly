{
  "name": "awaitly-durable-lambda",
  "version": "0.0.0",
  "type": "module",
  "description": "Drop-in, typed handler facade over the AWS Lambda durable execution SDK, for awaitly Result-returning steps",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "node node_modules/tsgo/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "eslint .",
    "clean": "rm -rf dist",
    "quality": "pnpm type-check && pnpm test && pnpm lint",
    "test:aws": "vitest run --config vitest.aws.config.ts",
    "aws:deploy": "tsx e2e/aws.ts deploy",
    "aws:destroy": "tsx e2e/aws.ts destroy"
  },
  "keywords": [
    "awaitly",
    "workflow",
    "aws",
    "lambda",
    "durable-functions",
    "durable-execution",
    "result",
    "typescript"
  ],
  "author": "Jag Reehal <jag@jagreehal.com>",
  "homepage": "https://github.com/jagreehal/awaitly#readme",
  "bugs": {
    "url": "https://github.com/jagreehal/awaitly/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagreehal/awaitly.git"
  },
  "license": "MIT",
  "peerDependencies": {
    "awaitly": "workspace:^",
    "@aws/durable-execution-sdk-js": "^2.6.0",
    "@aws/durable-execution-sdk-js-testing": "^1.3.0"
  },
  "dependencies": {
    "@types/aws-lambda": "8.10.161"
  },
  "devDependencies": {
    "@aws-sdk/client-iam": "3.1147.0",
    "@aws-sdk/client-lambda": "3.1147.0",
    "@aws/durable-execution-sdk-js": "2.6.0",
    "@aws/durable-execution-sdk-js-otel": "1.1.0",
    "@aws/durable-execution-sdk-js-testing": "1.3.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@standard-schema/spec": "1.1.0",
    "@types/node": "25.9.3",
    "awaitly": "workspace:^",
    "esbuild": "0.28.1",
    "eslint-plugin-awaitly": "workspace:^",
    "tsgo": "npm:typescript@7.0.2",
    "tsup": "8.5.1",
    "tsx": "4.23.8",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependenciesMeta": {
    "@aws/durable-execution-sdk-js-testing": {
      "optional": true
    }
  }
}
